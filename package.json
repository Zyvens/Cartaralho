{
  "name": "cartaralho",
  "version": "1.0.0",
  "description": "Cartaralho - Jogo de cartas multiplayer em tempo real",
  "main": "main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "start:desktop": "electron .",
    "build": "electron-builder --win",
    "share": "lt --port 14273 --subdomain cartaralho"
  },
  "build": {
    "appId": "com.cartaralho.game",
    "productName": "Cartaralho",
    "files": [
      "**/*",
      "!tools/**/*",
      "!web/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "express": "^4.21.0",
    "localtunnel": "^2.0.2",
    "node-machine-id": "^1.1.12",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3"
  },
  "keywords": [
    "card-game",
    "multiplayer",
    "real-time",
    "socket.io"
  ],
  "license": "MIT"
}
