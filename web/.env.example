# Copy this file's variable names into the Vercel project's Environment
# Variables settings (Project → Settings → Environment Variables).
# Never commit a real .env file.

# Neon Postgres — Storage tab in Vercel → Connect Store → Neon → gives you this.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Pusher — create a free "Channels" app at https://dashboard.pusher.com
# App Keys page gives you all four of these.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Admin panel (deck editor) — pick your own strong password, required.
ADMIN_USER=admin
ADMIN_PASSWORD=
