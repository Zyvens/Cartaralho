# Copy this file's variable names into the Vercel project's Environment Variables.
# Never commit a real .env file.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
ADMIN_USER=admin
ADMIN_PASSWORD=

# P12 — flags operacionais. Todas assumem true quando ausentes.
MARKETPLACE_ENABLED=true
MATCH_LOOT_ENABLED=true
CARD_PROGRESSION_V2_ENABLED=true
BUFFS_FEATURE_ENABLED=true
ADVANCED_ROUND_ENGINE=true
ECONOMY_SETTLEMENTS_ENABLED=true
ACHIEVEMENTS_V2_ENABLED=true
COSMETICS_FEATURE_ENABLED=true
TELEMETRY_ENABLED=true

# JSON opcional para knobs explicitamente calibráveis; vazio = defaults v1.4 versionados.
BALANCE_OVERRIDES_JSON=
